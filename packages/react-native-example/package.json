{
  "name": "@pds/react-native-example",
  "version": "0.0.0",
  "private": true,
  "description": "Expo preview app for @pds/react-native — Button in Brand A and Brand B. Not a library and never published.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "preexport": "npm run build -w @pds/tokens",
    "export": "expo export --platform ios --platform android --output-dir dist",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@pds/react-native": "0.0.0",
    "expo": "~58.0.14",
    "expo-font": "~58.0.8",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "typescript": "^5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "@types/react"
      ]
    }
  }
}
