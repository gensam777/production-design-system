{
  "name": "@pds/react",
  "version": "0.0.0",
  "private": true,
  "description": "Production Design System — React components, tokens CSS and Storybook (web reference implementation).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./index.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build -w @pds/tokens && tsup",
    "typecheck": "tsc --noEmit",
    "prestorybook": "npm run build",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run build",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "lucide-react": "^1.41.0"
  },
  "devDependencies": {
    "@pds/tokens": "0.0.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "chromatic": "^18.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "tsup": "^8.5.1",
    "vite": "^8.2.2"
  }
}
