{
  "font": {
    "family": {
      "mono": {
        "$value": "Roboto Mono",
        "$type": "fontFamily",
        "$description": "Code/data typeface — inline code, IDs, tabular/numeric values."
      }
    },
    "size": {
      "xs": { "$value": 12, "$type": "dimension", "$description": "12px. Captions/labels only — never primary reading content." },
      "sm": { "$value": 14, "$type": "dimension", "$description": "14px." },
      "md": { "$value": 16, "$type": "dimension", "$description": "16px. Base body size — the floor for primary reading content." },
      "lg": { "$value": 18, "$type": "dimension", "$description": "18px." },
      "xl": { "$value": 20, "$type": "dimension", "$description": "20px." },
      "2xl": { "$value": 24, "$type": "dimension", "$description": "24px." },
      "3xl": { "$value": 30, "$type": "dimension", "$description": "30px." },
      "4xl": { "$value": 36, "$type": "dimension", "$description": "36px. Largest step in this scale — no editorial/marketing display sizes." }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" }
    },
    "lineHeight": {
      "tight": { "$value": 1.25, "$type": "number", "$description": "Unitless ratio. Headings." },
      "normal": { "$value": 1.5, "$type": "number", "$description": "Unitless ratio. Body/UI text — matches WCAG 1.4.8's recommended paragraph line-height." }
    },
    "letterSpacing": {
      "tight": { "$value": -0.01, "$type": "number", "$description": "Large headings only — modest by design, never applied to body/label/caption sizes.", "$extensions": { "com.pds": { "unit": "em" } } },
      "normal": { "$value": 0, "$type": "number", "$extensions": { "com.pds": { "unit": "em" } } }
    }
  }
}
