{
  "color": {
    "gray": {
      "50": { "$value": "#F9FAFB", "$type": "color", "$description": "Neutral primitive scale — surfaces, borders, text." },
      "100": { "$value": "#F3F4F6", "$type": "color" },
      "200": { "$value": "#E5E7EB", "$type": "color" },
      "300": { "$value": "#D1D5DB", "$type": "color" },
      "400": { "$value": "#9CA3AF", "$type": "color" },
      "500": { "$value": "#6B7280", "$type": "color" },
      "600": { "$value": "#4B5563", "$type": "color" },
      "700": { "$value": "#374151", "$type": "color" },
      "800": { "$value": "#1F2937", "$type": "color" },
      "900": { "$value": "#111827", "$type": "color" }
    },
    "blue": {
      "50": {
        "$value": "#EFF6FF",
        "$type": "color",
        "$description": "Brand primitive scale. Blue is the default working brand hue for this template — a future consuming product may replace this entire scale and remap semantic tokens to a different hue without touching semantic token names."
      },
      "100": { "$value": "#DBEAFE", "$type": "color" },
      "200": { "$value": "#BFDBFE", "$type": "color" },
      "300": { "$value": "#93C5FD", "$type": "color" },
      "400": { "$value": "#60A5FA", "$type": "color" },
      "500": { "$value": "#3B82F6", "$type": "color" },
      "600": { "$value": "#2563EB", "$type": "color" },
      "700": { "$value": "#1D4ED8", "$type": "color" },
      "800": { "$value": "#1E40AF", "$type": "color" },
      "900": { "$value": "#1E3A8A", "$type": "color" }
    },
    "red": {
      "50": { "$value": "#FEF2F2", "$type": "color", "$description": "Feedback primitive — danger/error. Reduced scale (subtle/default/emphasis only, no full ramp)." },
      "100": { "$value": "#FEE2E2", "$type": "color" },
      "600": { "$value": "#DC2626", "$type": "color" },
      "700": { "$value": "#B91C1C", "$type": "color" }
    },
    "green": {
      "50": { "$value": "#F0FDF4", "$type": "color", "$description": "Feedback primitive — success. Reduced scale." },
      "100": { "$value": "#DCFCE7", "$type": "color" },
      "600": { "$value": "#16A34A", "$type": "color" },
      "700": { "$value": "#15803D", "$type": "color" }
    },
    "amber": {
      "50": { "$value": "#FFFBEB", "$type": "color", "$description": "Feedback primitive — warning. Reduced scale." },
      "100": { "$value": "#FEF3C7", "$type": "color" },
      "600": { "$value": "#D97706", "$type": "color" },
      "700": { "$value": "#B45309", "$type": "color" },
      "800": { "$value": "#92400E", "$type": "color" }
    },
    "cyan": {
      "50": { "$value": "#ECFEFF", "$type": "color", "$description": "Feedback primitive — info. Distinct hue from brand blue so info doesn't read as a primary action. Reduced scale." },
      "100": { "$value": "#CFFAFE", "$type": "color" },
      "600": { "$value": "#0891B2", "$type": "color" },
      "700": { "$value": "#0E7490", "$type": "color" }
    },
    "white": { "$value": "#FFFFFF", "$type": "color", "$description": "Fixed primitive, no scale." },
    "black": { "$value": "#000000", "$type": "color", "$description": "Fixed primitive, no scale." },
    "overlay": {
      "subtle": { "$value": "rgba(0, 0, 0, 0.05)", "$type": "color", "$description": "Alpha-blended black. Named generically (not shadow-specific) so a future surface.overlay/scrim token can reuse it — see governance/decisions/0007-elevation-token-architecture.md." },
      "default": { "$value": "rgba(0, 0, 0, 0.08)", "$type": "color" },
      "strong": { "$value": "rgba(0, 0, 0, 0.12)", "$type": "color" }
    }
  }
}
