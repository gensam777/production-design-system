{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PDS font asset catalog",
  "description": "Font asset metadata for native platforms (ADR 0016). Not tokens. The build enforces the same rules in scripts/tokens/fonts.mjs (no schema-validator dependency yet).",
  "type": "object",
  "required": ["format", "version", "families"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "$description": { "type": "string" },
    "format": { "const": "pds.fonts" },
    "version": { "const": 1 },
    "families": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/family" }
    }
  },
  "$defs": {
    "family": {
      "type": "object",
      "required": ["license", "source", "verified", "faces"],
      "additionalProperties": false,
      "properties": {
        "license": { "enum": ["OFL-1.1", "Apache-2.0"] },
        "source": {
          "type": "object",
          "required": ["name", "url"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" },
            "url": { "type": "string" },
            "note": { "type": "string" }
          }
        },
        "verified": {
          "type": "boolean",
          "description": "true once every postScriptName has been checked against the real file's name table."
        },
        "faces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/face" } }
      }
    },
    "face": {
      "type": "object",
      "required": ["weight", "style", "file", "postScriptName"],
      "additionalProperties": false,
      "properties": {
        "weight": { "enum": [100, 200, 300, 400, 500, 600, 700, 800, 900] },
        "style": { "enum": ["normal", "italic"] },
        "file": { "type": "string", "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*\\.(ttf|otf)$" },
        "postScriptName": { "type": "string", "pattern": "^[!-~]{1,63}$" }
      }
    }
  }
}
