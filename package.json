{
  "name": "production-design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Production Design System — one repo for web, React Native, iOS and Android (ADR 0013). npm workspaces: packages/*; platform-neutral source in design/; native packages in platforms/.",
  "type": "module",
  "workspaces": [
    "packages/tokens",
    "packages/react",
    "packages/react-native",
    "packages/react-native-example"
  ],
  "scripts": {
    "build": "npm run build -w @pds/react",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && node scripts/check-token-usage.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:build": "npm run build -w @pds/tokens",
    "tokens:test": "npm run test -w @pds/tokens",
    "tokens:test:update": "npm run test:update -w @pds/tokens",
    "contracts:validate": "node scripts/contracts/validate.mjs",
    "contracts:test": "node --test scripts/contracts/__tests__/contracts.test.mjs",
    "icons:test": "node --test scripts/icons/__tests__/icons.test.mjs",
    "icons:swift": "node scripts/icons/generate-swift.mjs",
    "icons:kotlin": "node scripts/icons/generate-kotlin.mjs",
    "test:react-native": "npm run test -w @pds/react-native",
    "design:audit": "node scripts/design-audit/audit.mjs",
    "design:audit:test": "node --test scripts/design-audit/__tests__/audit.test.mjs",
    "design:audit:snapshot": "node scripts/design-audit/snapshot.mjs",
    "design:audit:refresh": "node scripts/design-audit/refresh.mjs",
    "storybook": "npm run storybook -w @pds/react",
    "build-storybook": "npm run build-storybook -w @pds/react",
    "example:react-native": "npm run start -w @pds/react-native-example",
    "example:react-native:export": "npm run export -w @pds/react-native-example"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.69.0",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.12.0",
    "lucide-static": "1.41.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
